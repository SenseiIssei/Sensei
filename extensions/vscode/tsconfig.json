{
  "compilerOptions": {
    // esbuild emits the CommonJS bundle; tsc only typechecks, so it uses the
    // bundler resolution mode. ("node10" was removed in TypeScript 7.)
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vscode"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // esbuild produces dist/extension.js; tsc is only used to typecheck.
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
