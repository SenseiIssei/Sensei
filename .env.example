# Sensei configuration.
#
# You almost certainly don't need this file. Run `sensei up` and the web UI
# will ask you for a provider and a key on first launch, then write them here
# for you — API keys go into an encrypted vault, never plaintext.
#
# Every other setting and its default: docs/configuration.md

# Where to get answers from. `auto` tries Ollama, then a local model, then an
# API provider — so leaving this alone usually just works.
SENSEI_MODEL_PROVIDER=auto

# Which hosted provider to use when there's no local model.
# openrouter | zai | openai | anthropic | google | groq | mistral | together
# | deepseek | cohere | fireworks | perplexity | huggingface | custom
SENSEI_API_PROVIDER=openrouter
SENSEI_OPENROUTER_API_KEY=

# Loopback only. Set to 0.0.0.0 to expose Sensei to your network — and if you
# do, turn on SENSEI_AUTH_ENABLED and put TLS in front of it first.
# See deploy/README.md.
SENSEI_HOST=127.0.0.1
SENSEI_PORT=7000
