{
  "name": "sensei-frontend",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && node scripts/build-sw-precache.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:offline": "node scripts/check-no-external-assets.mjs dist",
    "check:subpath": "node scripts/check-subpath-safe.mjs dist",
    "audit:gate": "node scripts/audit-gate.mjs --level=high"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "edge >= 111"
  ],
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
